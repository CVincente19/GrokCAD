  <icon>resources/icons/GrokCAD.svg</icon>
  <tag>ai</tag>
  <tag>grok</tag>
  <tag>xai</tag>
  <tag>agent</tag>
  <tag>partdesign</tag>
  <tag>chat</tag>
  <freecadmin>1.0.0</freecadmin>
  <depend optional="false">openai</depend>
